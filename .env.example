# =============================================================================
# Django RealWorld API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-super-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# MySQL Database Configuration
# -----------------------------------------------------------------------------
# Create the database first:
#   mysql -u root -p
#   CREATE DATABASE conduit CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'conduit_user'@'localhost' IDENTIFIED BY 'your_password';
#   GRANT ALL PRIVILEGES ON conduit.* TO 'conduit_user'@'localhost';
#   FLUSH PRIVILEGES;
# -----------------------------------------------------------------------------
DB_NAME=conduit
DB_USER=conduit_user
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_PORT=3306

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
